# .env.example — plantilla de entorno por worktree de agente (Talos · Fase 2)
#
# `wt create --agent=<figura>` genera talos.wt/agent-<figura>/.env con SOLO las
# variables de aislamiento (PORT + DB_SCHEMA), deterministas y disjuntas por
# figura. Las credenciales Jira NO se escriben por worktree: se heredan del
# entorno padre (ATHENA las propaga al loop de evidencia).

# --- Aislamiento por worktree (lo que genera `wt create`) ---
PORT=8100
DB_SCHEMA=wt_atlas

# --- Credenciales del loop de evidencia (heredadas del entorno padre, NO por worktree) ---
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_SITE_URL=https://tablex.atlassian.net